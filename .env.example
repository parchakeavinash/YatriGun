# ==============================================================================
# YatriGun - Multi-Agent AI Travel Planner Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# Do NOT commit your actual .env file to version control.

# --- LLM Provider Settings ---
# Google Gemini API Key (Recommended for agent reasoning & high token limits)
# Get key from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Groq API Key (Optional fallback provider)
# GROQ_API_KEY=your_groq_api_key_here

# --- MCP Tool Providers ---
# Tavily Search API Key (Used by Tavily MCP for hotel & web searches)
# Get key from: https://app.tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# Aviationstack API Key (Used by Aviationstack MCP for flight route analysis)
# Get key from: https://aviationstack.com/
AVIATIONSTACK_API_KEY=your_aviationstack_api_key_here

# OpenWeather API Key (Used by OpenWeather MCP for current weather & forecasts)
# Get key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# --- Checkpointer & State Persistence ---
# PostgreSQL connection string for LangGraph checkpointer
# Example: postgresql://username:password@localhost:5432/travel_agent
DATABASE_URL="postgresql://postgres:password@localhost:5432/travel_agent"
